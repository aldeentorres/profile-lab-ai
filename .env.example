CODEFORMER_SERVICE_URL=http://127.0.0.1:7861
CODEFORMER_SERVICE_TOKEN=local-codeformer-demo
# Optional generative portrait adapter behind "Generate AI Portrait" (server-side only; the on-device
# pipeline is used when unset). PORTRAIT_IMAGE_MODEL defaults to gpt-image-1.
OPENAI_API_KEY=
# Optional server-side gate for the unlisted /designer workspace.
DESIGNER_ACCESS_CODE=
# Local mock recipient when real email test mode is off.
TEST_EMAIL_RECIPIENT=
# Temporary real-delivery override. Every personalised email is sent separately to this address.
EMAIL_TEST_MODE=false
TEST_EMAIL_OVERRIDE=
# Start `npm run smtp:bridge` in a second terminal when EMAIL_TEST_MODE=true.
SMTP_BRIDGE_URL=http://127.0.0.1:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_AUTH=login
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_BRIDGE_PORT=3001
STUDIO_PUBLIC_URL=http://localhost:3000
